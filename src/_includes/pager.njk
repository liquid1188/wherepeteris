{%- if l.pages > 1 %}
<nav class="pager" aria-label="Pages">
  {% if l.prev %}<a href="{{ l.prev }}" rel="prev">Newer</a>{% else %}<span></span>{% endif %}
  <span>Page {{ l.page }} of {{ l.pages }}</span>
  {% if l.next %}<a href="{{ l.next }}" rel="next">Older</a>{% else %}<span></span>{% endif %}
</nav>
{%- endif %}
