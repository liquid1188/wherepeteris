---
pagination: { data: wpi.pages, size: 1, alias: pg, filter: [] }
permalink: "{{ pg.url }}"
layout: base.njk
eleventyComputed:
  title: "{{ pg.title }}"
  description: "{{ pg.summary }}"
  eleventyExcludeFromCollections: true
---
<article class="post" data-pagefind-body >
  <header class="post-head wrap-narrow"><h1>{{ pg.title }}</h1></header>
  {%- if pg.image %}<figure class="post-hero wrap-narrow"><img src="{{ pg.image.src }}" alt="{{ pg.image.alt | attr }}" width="{{ pg.image.width }}" height="{{ pg.image.height }}"></figure>{% endif %}
  <div class="prose wrap-narrow">{{ pg.content | safe }}</div>
  {%- if pg.children.length %}<nav class="wrap-narrow subpages" aria-label="In this section"><h2 class="section-title">In this section</h2><ul>{% for c in pg.children %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}</ul></nav>{% endif %}
</article>
